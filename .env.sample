# farm_assistant_hermes — adapter configuration.
# Copy to .env and fill in. Secrets never belong in this file; it is tracked.

FA_ENV=local
LOG_LEVEL=INFO
ENABLE_DOCS=false

# --- Django (auth realm + chat persistence + MEMORY) ---------------------
# Must be the SAME Django that minted the caller's JWT, or introspection fails
# and every request is anonymous. Local dev against dev:
#   https://admin-auth-service.dev.farmbook.ugent.be
CHAT_BACKEND_URL=
AUTH_BACKEND_URL=
AUTH_TOKEN_INTROSPECTION=true
VERIFY_SSL=true
REQUIRE_CHAT_AUTH=true

# --- Caller API-key gate --------------------------------------------------
# csv of `label:sha256hex`. Plaintext keys are distributed out of band and never
# stored here. Mint one with:
#   python -c "import secrets,hashlib;k='eufb_'+secrets.token_urlsafe(32);print(k);print(hashlib.sha256(k.encode()).hexdigest())"
REQUIRE_API_KEY=true
CHAT_API_KEYS=
API_KEY_HEADER=X-API-Key

# --- Retrieval (scout) ----------------------------------------------------
# The same endpoint farm_assistant_um uses. Keep them identical: v2 and v3 must
# retrieve from the same place for the pilot comparison to mean anything.
OPENSEARCH_API_URL=
OS_RAG_API_PATH=/llm_retrieve
OPENSEARCH_API_USR=
OPENSEARCH_API_PWD=
RETRIEVAL_CANDIDATE_K=10
RELEVANCE_MODE=overlap
TOP_K=5
MAX_CONTEXT_CHARS=24000
PLATFORM_PUBLIC_URL=https://eufarmbook.eu

# --- Hermes ---------------------------------------------------------------
# In compose this is set to http://hermes:8642 by docker-compose.yml.
HERMES_API_URL=http://127.0.0.1:8642
# Must equal API_SERVER_KEY in hermes-data/.env. Also used as the MCP bridge key.
HERMES_API_KEY=
HERMES_MULTIPLEX_PROFILES=true
HERMES_REQUEST_TIMEOUT_SECONDS=180

# --- Access ---------------------------------------------------------------
# true = any authenticated EU-FarmBook user can chat; their agent is created on
# their first message and nobody has to enrol them. Identity is still verified
# against Django — this removes the roster, not the login.
#
# Every turn is billed to MISTRAL_API_KEY and every new user costs a profile
# directory, so keep the limiter on and consider a MAX_PROFILES ceiling.
HERMES_OPEN_ACCESS=true

# Per verified user. An agent turn is several model calls, so these are lower
# than a plain chat service would use. 0 disables an individual limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TURNS_PER_MIN=6
RATE_LIMIT_TURNS_PER_DAY=120

# Hard ceiling on how many agents can ever exist (disk + blast radius).
# 0 = unlimited. Existing users keep working when it is reached; new ones are
# refused with a clear log line.
MAX_PROFILES=0

# --- Roster (ignored when HERMES_OPEN_ACCESS=true) -------------------------
# Configure AT LEAST ONE of the three, or nobody gets in (it fails closed).
# Profiles are created automatically on a user's first turn either way.
#
# 1. Easiest to run: anyone whose verified token carries an email at one of
#    these domains. No uuids to look up, nothing to maintain.
HERMES_PILOT_EMAIL_DOMAINS=

# 2. A file of uuids on the mounted volume, one per line, `#` comments allowed.
#    Re-read every 30s, so `echo <uuid> >> roster.txt` needs no restart. Find a
#    uuid by having the person open the page once and grepping the adapter log
#    for "Rejecting chat for uuid=".
HERMES_PILOT_ROSTER_FILE=

# 3. Static list. Requires a container restart to change.
HERMES_PILOT_UUIDS=

# Optional `uuid:profile` naming overrides, for profiles seeded by hand with
# readable names. Not the roster. Default profile id is the user's uuid.
HERMES_PROFILE_MAP=

# The agent's data volume as the adapter sees it (compose mounts ./hermes-data).
HERMES_DATA_DIR=/opt/data

# --- Memory summary -------------------------------------------------------
# Powers the settings dialog's "Memory summary / Update" button, and nothing
# else. A plain completion, deliberately not an agent turn: summarising stored
# facts must not run a tool loop, enter the transcript, or trigger a retrieval.
# Blank = the button returns the cached summary instead of regenerating.
MISTRAL_API_URL=https://api.mistral.ai
MISTRAL_API_KEY=
MEMORY_SUMMARY_MODEL=mistral-medium-latest
