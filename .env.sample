# farm_assistant_hermes — adapter configuration.
#
# Copy to .env and fill in the blanks. This file is TRACKED: no secrets here.
# Values below are the NEXAVION (deployed) settings; the local differences are
# listed immediately under this header.
#
# Settings that already match their default in app/config.py are commented out
# with that default shown, so a copied file stays short and the active lines are
# exactly the ones you must supply. Uncomment only to deviate.
#
# TWO env files, and forgetting the second is the classic mistake:
#   .env               this file — the adapter
#   hermes-data/.env   the agent: API_SERVER_KEY (== HERMES_API_KEY here) and
#                      LLM_API_KEY. A named profile cannot borrow the
#                      listener's credentials, so the agent needs its own copy.
#
# ── For a LOCAL stack, change exactly these ──────────────────────────────
#   FA_ENV=local                 (keeps the fail-closed startup check happy
#                                 without a reachable Django)
#   REQUIRE_API_KEY=false        (no caller key to present by hand)
#   HERMES_DATA_DIR              leave as /opt/data for compose; for a bare
#                                `./run.sh` override it on the command line:
#                                HERMES_DATA_DIR=$PWD/hermes-data ./run.sh
#   uncomment the adapter's `ports:` block in docker-compose.yml, and
#   `docker network create traefik-net` once
# ─────────────────────────────────────────────────────────────────────────

# "local" | "dev" | "prd". NOT local on nexavion: with any other value main.py
# REFUSES TO START unless token introspection is configured, because
# auth_service would otherwise fall back to an unverified JWT decode — and the
# uuid is the only thing deciding which agent and whose memory a request reaches.
FA_ENV=prd

# LOG_LEVEL=INFO
# ENABLE_DOCS=false          # keep false on a public host

# --- Django (auth realm + chat persistence + MEMORY) ---------------------
# Must be the SAME Django that minted the caller's JWT, or introspection fails
# and every request is anonymous. Leaving these blank resolves the realm from
# FA_ENV: local -> http://127.0.0.1:8000
#                  dev -> https://backend-admin.dev.farmbook.ugent.be
#                  prd -> https://backend-admin.prd.farmbook.ugent.be
# Set them explicitly if the frontend logs into anything else.
# CHAT_BACKEND_URL=
# AUTH_BACKEND_URL=
# AUTH_TOKEN_INTROSPECTION=true   # never false on a public host
# VERIFY_SSL=true
# REQUIRE_CHAT_AUTH=true

# --- Caller API-key gate --------------------------------------------------
# A valid login is who the user is; this key is whether the CALLER is
# sanctioned. csv of `label:sha256hex` — plaintext keys are distributed out of
# band and never stored. Mint one with:
#   python -c "import secrets,hashlib;k='eufb_'+secrets.token_urlsafe(32);print(k);print(hashlib.sha256(k.encode()).hexdigest())"
REQUIRE_API_KEY=true
CHAT_API_KEYS=

# --- CORS ----------------------------------------------------------------
# Comma-separated origins allowed to call this from a BROWSER. Empty (default)
# installs no CORS middleware at all: correct for a server-to-server caller,
# and the reason a browser page on another origin cannot call this service —
# its preflight goes unanswered. No wildcard is accepted; this service is
# handed platform JWTs.
CORS_ALLOW_ORIGINS=
# API_KEY_HEADER=X-API-Key

# --- Retrieval (scout) ----------------------------------------------------
# The same endpoint farm_assistant_um uses. Keep them identical: v2 and v3 must
# retrieve from the same place for the pilot comparison to mean anything.
# If either credential is blank the request goes out unauthenticated and scout
# answers 401, which reads downstream as "the platform has nothing".
OPENSEARCH_API_URL=
OPENSEARCH_API_USR=
OPENSEARCH_API_PWD=
# OS_RAG_API_PATH=/llm_retrieve
# RETRIEVAL_CANDIDATE_K=10
# RELEVANCE_MODE=overlap          # "overlap" | "semantic"
# TOP_K=5
# MAX_CONTEXT_CHARS=24000
# PLATFORM_PUBLIC_URL=https://eufarmbook.eu
#
# Keep these three ALIGNED WITH farm_assistant_um, or "weak" stops meaning the
# same thing in v2 and v3 and the pilot comparison loses its point. Note what
# differs is not the numbers but what happens next: v2 drops context below the
# threshold, v3 reports the verdict to the agent and lets it decide.
# RETRIEVAL_MIN_SCORE=1.0         # per-item OpenSearch score floor (junk cut)
# RETRIEVAL_DROP_THRESHOLD=0.15   # overlap mode
# SEMANTIC_DROP_THRESHOLD=0.88    # semantic mode; msmarco-specific, re-calibrate per model

# --- Personal data reaching the provider ---------------------------------
# Address the user by first name when the verified token carries one. Set false
# to send the inference provider nothing that NAMES the person: the remembered
# profile on its own is pseudonymous, a name is not. Worth a deliberate decision
# on a deployment whose inference is third-party.
# INCLUDE_USER_NAME=true

# --- Attachments (documents only; no image path in v3) -------------------
# Extracted at upload and held in-process, so these bound memory as much as
# they bound the upload — attachments do not survive a restart.
# ATTACHMENT_MAX_BYTES=15728640   # 15 MB
# ATTACHMENT_MAX_CHARS=120000

# --- Agent ----------------------------------------------------------------
# Must equal API_SERVER_KEY in hermes-data/.env. Also the MCP bridge key, which
# the bridge re-reads from /opt/data/bridge.key per call — so rotating it needs
# no agent restart. If the two files drift, every turn 401s adapter->agent and
# every tool call 401s bridge->adapter.
HERMES_API_KEY=
# The agent's model. Changing this and restarting re-renders every profile, so
# comparing models is an env change, not a config edit. It MUST have reliable
# tool calling and at least 64k context (Hermes' floor) — list what the key can
# reach with:
#   curl -s $LLM_API_URL/v1/models -H "Authorization: Bearer $LLM_API_KEY" | jq -r '.data[].id'
#
# qwen3.5-397b-a17b is a REASONING model: its thinking arrives in a separate
# `reasoning` field (never in `content`, so it cannot leak to the UI) but is
# billed against the template's max_tokens — hence 16384 there, not 4096.
HERMES_MODEL=qwen3.5-397b-a17b
# HERMES_MULTIPLEX_PROFILES=true  # off = everyone shares one agent. Don't.
# HERMES_REQUEST_TIMEOUT_SECONDS=180
# HERMES_API_URL=http://127.0.0.1:8642
#   ^ pointless in compose: docker-compose.yml sets http://hermes:8642 in the
#     service `environment:`, which overrides this file.

# --- Inference provider (Scaleway Generative APIs) ------------------------
# One OpenAI-compatible endpoint for everything: the agent reaches it through
# the `providers` block in hermes-data/config.template.yaml, and the adapter
# calls it directly for the four features that must NOT run an agent turn
# (memory summary, memory-write guard, opening suggestions, follow-up chips).
#
# EU-hosted, which is the reason to prefer it: every turn ships the user's
# remembered profile to whoever serves inference.
#
# The key is a Scaleway IAM secret key. The SAME value must also go in
# hermes-data/.env as LLM_API_KEY.
#
# Project-scoped (what the console hands out) and bare both answer:
#   https://api.scaleway.ai/<project-id>        <- preferred, unambiguous
#   https://api.scaleway.ai
# NO trailing /v1: the call sites append /v1/chat/completions themselves. The
# agent's base_url in the template DOES include it.
LLM_API_URL=https://api.scaleway.ai/<project-id>
LLM_API_KEY=
# The cheap model for those four side-features, and it MUST NOT be a reasoning
# model: they ask for one word at max_tokens=5, and a reasoning model spends
# that budget on its `reasoning` field and returns empty content — which the
# memory guard reads as "cannot validate" and fails closed on, silently
# refusing every memory write. Of nine chat models on Scaleway, only
# llama-3.3-70b-instruct answered directly (gpt-oss-120b, glm-5.2, gemma-4,
# deepseek-v4-flash and both qwen3.x came back empty). Re-probe before changing.
MEMORY_SUMMARY_MODEL=llama-3.3-70b-instruct

# --- Access ---------------------------------------------------------------
# true = any authenticated EU-FarmBook user can chat; their agent is created on
# their first message and nobody has to enrol them. Identity is still verified
# against Django — this removes the roster, not the login.
#
# What becomes unbounded is spend (every turn is several billed model calls),
# disk (a profile directory per visitor) and how many people's remembered
# profiles reach a third party. Keep the limiter on.
HERMES_OPEN_ACCESS=true

# Per verified uuid, counted in-process (this service is single-replica by
# design — a per-replica limit on N replicas is an N-times-larger limit).
# An agent turn is several model calls, so these are lower than a plain chat
# service would use. 0 disables an individual limit.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TURNS_PER_MIN=6
# RATE_LIMIT_TURNS_PER_DAY=120

# Hard ceiling on how many agents can ever exist (disk + blast radius).
# 0 = unlimited; worth a real number on a public host. Existing users keep
# working when it is reached, only new enrolment is refused, with a clear log.
MAX_PROFILES=0

# The agent's data volume as the adapter sees it (compose mounts ./hermes-data
# at /opt/data). Both containers write here and must share a uid — the adapter
# runs as 1000:1000 for that reason.
# HERMES_DATA_DIR=/opt/data

# --- Roster (ignored while HERMES_OPEN_ACCESS=true) -----------------------
# For a CLOSED pilot, set HERMES_OPEN_ACCESS=false and configure AT LEAST ONE
# of the three below — with none of them, nobody is admitted: the gate fails
# closed. Profiles are still created automatically on a user's first turn.
#
# 1. Easiest to run: anyone whose verified token carries an email at one of
#    these domains. No uuids to look up, nothing to maintain.
# HERMES_PILOT_EMAIL_DOMAINS=
#
# 2. A file of uuids on the mounted volume, one per line, `#` comments allowed.
#    Re-read every 30s, so `echo <uuid> >> roster.txt` needs no restart. Find a
#    uuid by having the person open the page once and grepping the adapter log
#    for "Rejecting chat for uuid=".
# HERMES_PILOT_ROSTER_FILE=
#
# 3. Static list. Requires a container restart to change.
# HERMES_PILOT_UUIDS=
#
# Optional `uuid:profile` naming overrides, for profiles seeded by hand with
# readable names. NOT the roster (a uuid here is implicitly admitted); by
# default a user's profile id is simply their uuid.
# HERMES_PROFILE_MAP=
