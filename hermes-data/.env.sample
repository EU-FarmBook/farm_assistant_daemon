# Secrets for the AGENT container. Copy to hermes-data/.env — easy one to miss,
# because it lives inside what looks like a data directory and holds two lines.

# Inference provider for the agent (see config.yaml for the model choice and
# for the path back to self-hosted inference).
MISTRAL_API_KEY=

# Bearer key for the agent's OpenAI-compatible API on :8642.
# MUST equal HERMES_API_KEY in ../.env — the adapter presents it to the agent,
# and the MCP bridge reuses it as EUF_BRIDGE_KEY. If the two drift, every turn
# 401s adapter->agent and every tool call 401s bridge->adapter.
API_SERVER_KEY=
