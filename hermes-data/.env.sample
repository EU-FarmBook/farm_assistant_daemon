# Secrets for the AGENT container. Copy to hermes-data/.env — easy one to miss,
# because it lives inside what looks like a data directory.
#
# These are the DEFAULT profile's credentials. Each user profile gets its own
# .env, written by the adapter at provisioning; you do not manage those.

# Inference. `provider: custom` in config.yaml reads OPENAI_* — Mistral is not a
# Hermes provider id (see PROVIDER_REGISTRY), it is an OpenAI-compatible
# endpoint. The same two variables point at a self-hosted vLLM instead.
OPENAI_BASE_URL=https://api.mistral.ai/v1
OPENAI_API_KEY=

# Bearer key for the agent's OpenAI-compatible API on :8642.
# MUST equal HERMES_API_KEY in ../.env — the adapter presents it to the agent,
# and the MCP bridge reuses it as EUF_BRIDGE_KEY. If the two drift, every turn
# 401s adapter->agent and every tool call 401s bridge->adapter.
API_SERVER_KEY=
